{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "eve-alert",
  "version": "0.1.0",
  "identifier": "dev.ecamika.project.eve-alert",
  "build": {
    "frontendDist": "../dist/",
    "devUrl": "http://localhost:4567",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "EVE Alert",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
